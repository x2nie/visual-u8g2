{
    "name": "visual-u8g2",
    "version": "1.0.0",
    "description": "A tiny simulator to speedup UI creation for Arduino.",
    "type": "module",
    "scripts": {
        "clean": "rimraf dist",
        "init:dist": "mkdirp dist",
        "init:fonts:dir": "mkdirp dist/fonts",
        "init:fonts:files": "cp -R node_modules/font-awesome/fonts/* dist/fonts/",
        "init:bdf:files": "cd src && copy-newer -v ./bdf/**/* ../dist/",
        "init": "npm-run-all init:**",
        "build": "npm run-all clean && npm run init && parcel build ./src/index.html",
        "dev0": "npm-run-all init && parcel serve ./src/index.html",
        "build:xml": "node tools/bundle_xml/main.cjs",
        "watch:xml": "node tools/bundle_xml/watch_xml_templates.cjs",
        "dev": "vite",
        "start": "yarn watch:xml & vite"
    },
    "author": "Paul Smith <code@uvwxy.de>",
    "license": "ISC",
    "dependencies": {
        "@odoo/owl": "2.2.10",
        "bdf-canvas": "^1.0.1",
        "esprima": "^4.0.1",
        "font-awesome": "^4.7.0",
        "hsl-to-hex": "^1.0.0",
        "monaco-editor": "^0.52.2"
    },
    "devDependencies": {
        "node-watch": "^0.7.4",
        "sass": "^1.87.0",
        "typescript": "^4.9.5",
        "vite": "^6.3.4",
        "vite-plugin-monaco-editor": "^1.1.0"
    }
}
